# Copy this file to backend/.env 并根据需要修改各项配置。

# Host directory for docker volume persistence
DATA_PERSIST_ROOT=../.docker-data

# Database (used by prod profile)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_toolbox
DB_USERNAME=app_user
DB_PASSWORD=secret

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=your-redis-password

# Security tokens
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_TTL=3600
VCODE_EXPIRE_MINUTES=10
VCODE_INTERVAL_SECONDS=60
REFRESH_TOKEN_TTL_DAYS=30
DEFAULT_DEVICE=WEB

# LinuxDo OAuth
LINUXDO_CLIENT_ID=your-client-id
LINUXDO_CLIENT_SECRET=your-client-secret
LINUXDO_AUTHORIZE_URL=https://linux.do/oauth/authorize
LINUXDO_TOKEN_URL=https://linux.do/oauth/token
LINUXDO_PROFILE_URL=https://linux.do/api/profile
LINUXDO_REDIRECT_BASE_URL=https://app.local/oauth/linuxdo/callback
LINUXDO_STATE_TTL=5
