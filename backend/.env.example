# Copy this file to backend/.env 并根据需要修改各项配置。

# Host directory for docker volume persistence
DATA_PERSIST_ROOT=../.docker-data

# Database (used by prod profile)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_toolbox
DB_USERNAME=app_user
DB_PASSWORD=secret

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=your-redis-password

# CORS configuration
# 允许的前端域名，多个域名用逗号分隔
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security tokens
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_TTL=3600
VCODE_EXPIRE_MINUTES=10
VCODE_INTERVAL_SECONDS=60
REFRESH_TOKEN_TTL_DAYS=30
DEFAULT_DEVICE=WEB

# LinuxDo OAuth
LINUXDO_CLIENT_ID=your-client-id
LINUXDO_CLIENT_SECRET=your-client-secret
LINUXDO_AUTHORIZE_URL=https://connect.linux.do/oauth2/authorize
LINUXDO_TOKEN_URL=https://connect.linux.do/oauth2/token
LINUXDO_PROFILE_URL=https://connect.linux.do/api/user
# 前端回调页面地址（统一地址，不包含 locale）
LINUXDO_REDIRECT_BASE_URL=http://localhost:3000/oauth/linuxdo/callback
LINUXDO_STATE_TTL=5

# LinuxDo OAuth Proxy (optional, for regions that cannot directly access LinuxDo)
LINUXDO_PROXY_ENABLED=false
LINUXDO_PROXY_HOST=127.0.0.1
LINUXDO_PROXY_PORT=4780
LINUXDO_PROXY_USERNAME=
LINUXDO_PROXY_PASSWORD=
